.venv/
__pycache__/
*.pyc

# Raw and derived data are regenerated by `python run.py` (data.py downloads
# the UCI archive). Keeping them out avoids committing 6 MB of CSV that git
# cannot diff usefully.
data/raw/
data/processed/

# The trained model is 65 MB. Only the Random Forest selected by the report is
# tracked (force-added with `git add -f`), because the hosted Streamlit app
# needs it at runtime. Everything else in this folder stays local.
outputs/models/*.joblib
!outputs/models/best_model.joblib

run.log
.DS_Store
