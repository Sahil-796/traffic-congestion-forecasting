.venv/
__pycache__/
*.pyc

# Raw and derived data are regenerated by `python run.py` (data.py downloads
# the UCI archive). Keeping them out avoids committing 6 MB of CSV that git
# cannot diff usefully.
data/raw/
data/processed/

# The trained model is 65 MB and is rebuilt by `python run.py`. Figures and
# tables stay in the repo so the results are readable without running anything.
outputs/models/

run.log
.DS_Store
